generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

// User Roles Enum
enum UserRole {
  SUPER_ADMIN // Super Administrator - full system access
  ADMIN // System Administrator - user & system management
  FINANCE_MANAGER // Approves payments, budget oversight
  PROCUREMENT_MANAGER // Approves POs, manages procurement
  HEAD_OF_PROCUREMENT // Head of Procurement - contract approvals
  BILLING_ENGINEER // Billing Engineer - contract financial approval
  BUDGET_CONTROLLER // Budget control and monitoring
  PROJECT_MANAGER // Project-level approvals
  SITE_ENGINEER // Site operations and inspections
  WAREHOUSE_KEEPER // Goods receipts, inventory
  PROCUREMENT_OFFICER // Creates POs, manages RFQs
  APPROVER // General approval authority
  VIEWER // Read-only access
  // Legacy roles (for backward compatibility)
  REQUESTOR // Legacy - maps to VIEWER
  DEPARTMENT_MANAGER // Legacy - maps to APPROVER
  CPO // Legacy - maps to SUPER_ADMIN
  WAREHOUSE_MANAGER // Legacy - maps to WAREHOUSE_KEEPER
  SERVICE_MANAGER // Legacy - maps to PROJECT_MANAGER
  AUDITOR // Legacy - maps to VIEWER
  VENDOR // Legacy - external supplier
}

// User Model
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String // Hashed password
  name                String
  employeeId          String?   @unique
  mobile              String?
  department          String?
  role                UserRole  @default(VIEWER)
  approvalLimit       Decimal?  @default(0) // Max amount user can approve
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIP         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?

  // Relations
  sessions        Session[]
  auditLogs       AuditLog[]
  passwordHistory PasswordHistory[]
  // createdPRs           PurchaseRequisition[] @relation("PRCreator")  // Temporarily disabled
  // approvals            Approval[]  // Temporarily disabled

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// Session Model (for JWT session management)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Password History (prevent password reuse)
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Audit Log (track all user actions)
model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String // e.g., "user_created", "role_changed", "pr_approved"
  module       String // e.g., "user_management", "purchase_requisition"
  resourceId   String? // ID of affected resource
  resourceType String? // Type of resource
  oldValue     Json? // Before change
  newValue     Json? // After change
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

// Permission Model (defines all available permissions)
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "pr.create", "po.approve", "invoice.view"
  name        String // Human-readable name
  description String? // Description of what this permission allows
  module      String // e.g., "purchase_requisition", "purchase_order"
  action      String // e.g., "create", "read", "update", "delete", "approve"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
  @@index([isActive])
}

// Role Permissions (maps roles to permissions)
model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  conditions   Json? // e.g., {"scope": "own", "maxAmount": 5000}
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@index([isActive])
}

// ============================================
// VENDOR MANAGEMENT
// ============================================

// Vendor Management
model Vendor {
  id         String  @id @default(cuid())
  vendorCode String  @unique
  nameEn     String
  nameAr     String
  crNumber   String  @unique
  taxId      String  @unique
  vatNumber  String?

  // Contact Information
  primaryContactName String
  email              String
  mobile             String
  alternativePhone   String?
  website            String?
  address            Json

  // Banking Information
  bankName    String?
  bankAccount String?
  iban        String?

  // Business Details
  businessType          String
  yearEstablished       Int
  numberOfEmployees     Int
  omanizationPercentage Float?

  // Status
  status           VendorStatus @default(PENDING)
  performanceScore Float?

  // Relationships
  categories          VendorCategory[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  documents           VendorDocument[]
  evaluations         VendorEvaluation[]
  rfqResponses        RFQResponse[]
  rfqInvitations      RFQVendor[] // Vendors invited to RFQs
  serviceRFPVendors   ServiceRFPVendor[]
  serviceRFPResponses ServiceRFPResponse[]
  serviceContracts    ServiceContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorCategory {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isPrimary  Boolean  @default(false)

  @@unique([vendorId, categoryId])
}

model VendorDocument {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  documentType String
  documentName String
  fileUrl      String
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())
}

model VendorEvaluation {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  evaluationDate DateTime @default(now())
  qualityScore   Float
  deliveryScore  Float
  priceScore     Float
  serviceScore   Float
  overallScore   Float
  comments       String?
  evaluatedBy    String
}

model Category {
  id          String           @id @default(cuid())
  code        String           @unique
  nameEn      String
  nameAr      String
  description String?
  parent      Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    Category[]       @relation("CategoryHierarchy")
  vendors     VendorCategory[]
  items       Item[]
}

model Item {
  id            String   @id @default(cuid())
  itemCode      String   @unique
  nameEn        String
  nameAr        String
  description   String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unitOfMeasure String
  minStockLevel Int?
  maxStockLevel Int?
  reorderPoint  Int?

  // Relationships
  prItems      PRItem[]
  poItems      POItem[]
  grItems      GRItem[]
  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Purchase Requisition
model PurchaseRequisition {
  id           String   @id @default(cuid())
  prNumber     String   @unique
  requestDate  DateTime @default(now())
  requesterId  String?
  // requester       User?    @relation("PRCreator", fields: [requesterId], references: [id])  // Temporarily disabled
  departmentId String
  itemType     ItemType
  priority     Priority @default(NORMAL)
  status       PRStatus @default(DRAFT)

  // Budget
  estimatedCost Decimal
  budgetCode    String
  justification String?

  // Additional fields
  requiredByDate DateTime?
  projectId      String?
  boqReference   String?
  costCenter     String?
  createdBy      String?

  // Items
  items PRItem[]

  // Approval
  approvals Approval[]

  // Relationships
  purchaseOrders   PurchaseOrder[]
  rfqs             RFQ[]
  servicePR        ServicePR?
  serviceRFPs      ServiceRFP[]
  serviceContracts ServiceContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
}

model PRItem {
  id             String              @id @default(cuid())
  prId           String
  pr             PurchaseRequisition @relation(fields: [prId], references: [id])
  itemId         String
  item           Item                @relation(fields: [itemId], references: [id])
  quantity       Int
  estimatedPrice Decimal
  specifications String?
  requiredDate   DateTime?
}

// RFQ Management
model RFQ {
  id          String               @id @default(cuid())
  rfqNumber   String               @unique
  prId        String?
  pr          PurchaseRequisition? @relation(fields: [prId], references: [id])
  title       String
  description String?
  issueDate   DateTime             @default(now())
  closingDate DateTime
  status      RFQStatus            @default(DRAFT)
  createdBy   String? // User who created the RFQ

  // Additional fields for enhanced RFQ management
  evaluationCriteria String? // JSON string for evaluation criteria
  termsAndConditions String? // Terms and conditions text

  // Responses
  responses RFQResponse[]

  // Approval
  approvals Approval[]

  // Invited Vendors
  invitedVendors RFQVendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Junction table for RFQ and Vendors (invited vendors)
model RFQVendor {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  invitedAt DateTime @default(now())

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
}

model RFQResponse {
  id              String            @id @default(cuid())
  rfqId           String
  rfq             RFQ               @relation(fields: [rfqId], references: [id])
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  submittedAt     DateTime          @default(now())
  totalAmount     Decimal?
  validUntil      DateTime?
  status          RFQResponseStatus @default(SUBMITTED)
  technicalScore  Float?
  commercialScore Float?
  deliveryScore   Float?
  experienceScore Float?
  overallScore    Float? // Weighted total score

  // File attachments
  proposalFileUrl String? // Path to uploaded PDF
  attachments     Json? // Array of additional file paths

  // Additional proposal data
  priceBreakdown   String? // Price breakdown details
  technicalDetails String? // Technical specifications
  deliveryTerms    String? // Delivery terms and conditions
  notes            String? // Additional notes

  // Submission tracking
  submittedVia    String?   @default("EMAIL_LINK") // 'PORTAL', 'EMAIL_LINK', 'MANUAL'
  submissionToken String?   @unique // Unique token for email link submission
  submissionIp    String? // IP address of submission
  tokenSentAt     DateTime? // When the email with token was sent
  tokenUsed       Boolean   @default(false) // Whether token has been used
  token           String? // Alternative token field

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([rfqId, vendorId])
  @@index([submissionToken])
}

// Service RFP Models
model ServiceRFP {
  id                 String    @id @default(cuid())
  rfpNumber          String    @unique
  prId               String
  title              String
  description        String?   @db.Text
  issueDate          DateTime  @default(now())
  closingDate        DateTime
  status             RFPStatus @default(DRAFT)
  createdBy          String
  evaluationCriteria String?   @db.Text
  termsAndConditions String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  pr             PurchaseRequisition  @relation(fields: [prId], references: [id])
  invitedVendors ServiceRFPVendor[]
  responses      ServiceRFPResponse[]
  approvals      Approval[]           @relation("ServiceRFPApprovals")
}

model ServiceRFPVendor {
  id        String   @id @default(cuid())
  rfpId     String
  vendorId  String
  invitedAt DateTime @default(now())

  rfp    ServiceRFP @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendor Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([rfpId, vendorId])
}

model ServiceRFPResponse {
  id          String            @id @default(cuid())
  rfpId       String
  vendorId    String
  submittedAt DateTime?
  totalAmount Decimal?          @db.Decimal(15, 3)
  validUntil  DateTime?
  status      RFQResponseStatus @default(SUBMITTED)

  // Scoring
  technicalScore  Int?
  commercialScore Int?
  deliveryScore   Int?
  experienceScore Int?
  overallScore    Decimal? @db.Decimal(5, 2)

  // Submission details
  proposalFileUrl  String?
  attachments      String? @db.Text
  priceBreakdown   String? @db.Text
  technicalDetails String? @db.Text
  deliveryTerms    String? @db.Text
  notes            String? @db.Text

  // Token and tracking
  submittedVia    String?
  submissionToken String?   @unique
  submissionIp    String?
  tokenSentAt     DateTime?
  tokenUsed       Boolean   @default(false)
  token           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfp    ServiceRFP @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendor Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([rfpId, vendorId])
}

// Purchase Order
model PurchaseOrder {
  id                  String               @id @default(cuid())
  poNumber            String               @unique
  prId                String?
  pr                  PurchaseRequisition? @relation(fields: [prId], references: [id])
  vendorId            String
  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  orderDate           DateTime             @default(now())
  deliveryDate        DateTime
  deliveryAddress     Json
  paymentTerms        String
  status              POStatus             @default(DRAFT)
  totalAmount         Decimal
  currency            String               @default("OMR")
  createdBy           String? // User who created the PO
  acknowledgmentToken String?              @unique // Token for vendor acknowledgment via email
  acknowledgedAt      DateTime? // When vendor acknowledged the PO
  acknowledgedBy      String? // Vendor email or identifier

  // Items
  items POItem[]

  // Approval
  approvals Approval[]

  // Related documents
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  amendments    POAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model POItem {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  quantity     Int
  unitPrice    Decimal
  totalPrice   Decimal
  deliveryDate DateTime?

  // Relations
  invoiceItems InvoiceItem[]
}

model POAmendment {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  amendmentNo  Int
  changeType   String
  description  String
  oldValue     Json
  newValue     Json
  approvedBy   String?
  approvedDate DateTime?
  createdAt    DateTime      @default(now())
}

// Goods Receipt
model GoodsReceipt {
  id           String        @id @default(cuid())
  grNumber     String        @unique
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  receivedDate DateTime      @default(now())
  receivedBy   String
  status       GRStatus      @default(PENDING)

  // Receipt Details
  deliveryNote     String?
  transportDetails String?
  storageLocation  String?
  specialHandling  String?

  // Items
  items GRItem[]

  // Quality Check
  qualityChecked   Boolean @default(false)
  qualityComments  String?
  qualityInspector String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GRItem {
  id               String       @id @default(cuid())
  grId             String
  gr               GoodsReceipt @relation(fields: [grId], references: [id])
  itemId           String
  item             Item         @relation(fields: [itemId], references: [id])
  orderedQuantity  Int
  receivedQuantity Int
  acceptedQuantity Int
  rejectedQuantity Int
  rejectionReason  String?
}

// Invoice Management
model Invoice {
  id             String         @id @default(cuid())
  invoiceNumber  String         @unique
  vendorId       String
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id])
  invoiceDate    DateTime
  dueDate        DateTime
  totalAmount    Decimal
  taxAmount      Decimal
  discountAmount Decimal        @default(0)
  netAmount      Decimal        @default(0)
  currency       String         @default("OMR")

  // Status
  status InvoiceStatus @default(DRAFT)

  // Three-way matching
  threeWayMatched  Boolean        @default(false)
  matchingComments String?
  matchingStatus   MatchingStatus @default(PENDING)

  // Payment
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentDate      DateTime?
  paymentReference String?
  amountPaid       Decimal       @default(0)

  // Additional fields
  description  String?
  paymentTerms String?
  attachments  String[]

  // Line items
  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  poItemId    String?
  poItem      POItem? @relation(fields: [poItemId], references: [id])
  itemId      String
  item        Item    @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Approval Workflow
model Approval {
  id           String @id @default(cuid())
  documentType String
  documentId   String

  // Document relationships
  purchaseRequisitionId String?
  purchaseOrderId       String?
  invoiceId             String?
  rfqId                 String?
  prId                  String?
  serviceRFPId          String?
  serviceContractId     String?
  pr                    PurchaseRequisition? @relation(fields: [prId], references: [id])
  po                    PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  rfq                   RFQ?                 @relation(fields: [rfqId], references: [id])
  serviceRFP            ServiceRFP?          @relation("ServiceRFPApprovals", fields: [serviceRFPId], references: [id])
  serviceContracts      ServiceContract[]

  // Approval details
  approverId String
  // approver            User     @relation(fields: [approverId], references: [id])  // Temporarily disabled
  status     ApprovalStatus @default(PENDING)
  comments   String?
  approvedAt DateTime?
  level      Int

  // Routing
  routingRuleId String? // Link to ApprovalRule that determined this chain

  // History
  approvalHistory ApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([approverId])
  @@index([prId])
  @@index([purchaseRequisitionId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
  @@index([rfqId])
  @@index([serviceContractId])
  @@index([status])
  @@index([routingRuleId])
}

// ============================================
// ENHANCED APPROVAL WORKFLOW (Oracle AME / SAP Style)
// ============================================

// Approval Rules - Defines conditions for approval routing
model ApprovalRule {
  id           String  @id @default(cuid())
  name         String // e.g., "PR Approval - High Value"
  description  String?
  documentType String // "PR", "PO", "INVOICE", "PAYMENT"
  isActive     Boolean @default(true)
  priority     Int     @default(1) // Higher number = higher priority

  // Conditions (JSON for flexibility)
  conditions Json // e.g., {"minAmount": 50000, "maxAmount": null, "departments": ["IT", "HR"]}

  // Routing
  routings ApprovalRouting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([documentType])
  @@index([isActive])
  @@index([priority])
}

// Approval Routing - Defines approval chain levels
model ApprovalRouting {
  id           String       @id @default(cuid())
  ruleId       String
  rule         ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  level        Int // Approval sequence: 1, 2, 3...
  approverRole UserRole // Role that can approve at this level
  raciType     RACIType     @default(ACCOUNTABLE) // RACI designation
  isOptional   Boolean      @default(false) // Can be skipped?
  timeoutHours Int? // Auto-escalate after X hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ruleId, level])
  @@index([ruleId])
  @@index([approverRole])
}

// Approval Notifications - RACI Informed parties
model ApprovalNotification {
  id               String           @id @default(cuid())
  documentType     String
  documentId       String
  approvalId       String? // Reference to approval that triggered this
  userId           String
  raciType         RACIType         @default(INFORMED)
  notificationType NotificationType @default(EMAIL)
  isRead           Boolean          @default(false)
  sentAt           DateTime?
  readAt           DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([isRead])
}

// Approval Consultation - RACI Consulted parties
model ApprovalConsultation {
  id              String             @id @default(cuid())
  documentType    String
  documentId      String
  approvalId      String?
  consultedUserId String
  consultedRole   UserRole?
  raciType        RACIType           @default(CONSULTED)
  status          ConsultationStatus @default(PENDING)
  comments        String?
  respondedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultedUserId])
  @@index([documentId])
  @@index([status])
}

// Enhanced Approval History
model ApprovalHistory {
  id             String          @id @default(cuid())
  approvalId     String
  approval       Approval        @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  level          Int // Approval level this action occurred at
  action         String // SUBMITTED, APPROVED, REJECTED, DELEGATED, ESCALATED, REQUEST_EDIT
  performedBy    String?
  approverId     String? // User ID who performed the action
  approverName   String? // User name for display
  previousStatus ApprovalStatus?
  newStatus      ApprovalStatus?
  comments       String?
  metadata       Json? // Additional context
  timestamp      DateTime? // When the action occurred

  createdAt DateTime @default(now())

  @@index([approvalId])
  @@index([performedBy])
  @@index([approverId])
  @@index([level])
}

// Enums
enum VendorStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ItemType {
  STOCK
  NON_STOCK
  SERVICE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum POStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIAL
  COMPLETED
  CANCELLED
  REJECTED
}

enum RFQStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  SENT
  CLOSED
  EVALUATED
  AWARDED
  REJECTED
  ISSUED
  UNDER_EVALUATION
  COMPLETED
  CANCELLED
}

enum RFPStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  SENT
  CLOSED
  EVALUATED
  AWARDED
  REJECTED
}

enum RFQResponseStatus {
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  SHORTLISTED
  SELECTED
  REJECTED
}

enum GRStatus {
  PENDING
  PARTIAL
  COMPLETED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  OVERDUE
}

enum MatchingStatus {
  PENDING
  MATCHED
  DISCREPANCY
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

// RACI Matrix Types
enum RACIType {
  RESPONSIBLE // Person who executes the task
  ACCOUNTABLE // Person who approves/is ultimately responsible
  CONSULTED // Person who provides input before decision
  INFORMED // Person who is notified after action
}

// Consultation Status
enum ConsultationStatus {
  PENDING
  RESPONDED
  DECLINED
  EXPIRED
}

// Service-specific models for proper non-stock/service procurement

model ServiceCategory {
  id                      String  @id @default(cuid())
  code                    String  @unique
  nameEn                  String
  nameAr                  String
  description             String?
  requiresInsurance       Boolean @default(false)
  requiresCertification   Boolean @default(false)
  requiresPerformanceBond Boolean @default(false)

  // Relationships
  serviceItems ServiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceItem {
  id                 String          @id @default(cuid())
  serviceCode        String          @unique
  nameEn             String
  nameAr             String
  description        String?
  serviceCategoryId  String
  serviceCategory    ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  unitOfMeasure      String
  standardRate       Decimal?
  currency           String          @default("OMR")
  slaRequired        Boolean         @default(false)
  performanceMetrics Json?

  // Relationships
  servicePRItems ServicePRItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePR {
  id                      String              @id @default(cuid())
  prId                    String              @unique
  pr                      PurchaseRequisition @relation(fields: [prId], references: [id])
  serviceScope            String
  serviceCategory         String? // Service category (e.g., Professional Services)
  serviceType             String? // Service type (e.g., Consultancy)
  requestor               String? // Requestor name/ID
  technicalSpecifications String?
  qualityStandards        String? // Quality standards required
  duration                Int
  durationUnit            String              @default("DAYS")
  deliverables            Json
  performanceMetrics      Json?
  slaRequirements         Json?
  insuranceRequired       Boolean             @default(false)
  certificationRequired   Boolean             @default(false)
  safetyRequirements      String?
  paymentSchedule         String              @default("MILESTONE")
  paymentTerms            String? // Payment terms (e.g., NET_30)
  retentionPercentage     Decimal?            @default(0)
  preferredVendors        Json? // Array of vendor IDs
  milestones              Json? // Project milestones

  // Relationships
  items ServicePRItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePRItem {
  id                 String      @id @default(cuid())
  servicePRId        String
  servicePR          ServicePR   @relation(fields: [servicePRId], references: [id], onDelete: Cascade)
  serviceItemId      String
  serviceItem        ServiceItem @relation(fields: [serviceItemId], references: [id])
  quantity           Decimal
  estimatedRate      Decimal
  unit               String?     @default("Hours") // Unit of measure
  duration           Int
  durationUnit       String      @default("DAYS")
  specifications     String?
  deliverables       Json?
  performanceMetrics Json?
}

model ServiceContract {
  id                    String                @id @default(cuid())
  contractNumber        String                @unique
  prId                  String
  pr                    PurchaseRequisition   @relation(fields: [prId], references: [id])
  vendorId              String
  vendor                Vendor                @relation(fields: [vendorId], references: [id])
  contractType          String                @default("SERVICE_AGREEMENT")
  startDate             DateTime
  endDate               DateTime
  totalValue            Decimal
  serviceAmount         Decimal?              // Service-only portion; for service-only contracts equals totalValue
  currency              String                @default("OMR")
  paymentTerms          String
  slaTerms              Json?
  penaltyClause         String?
  performanceBond       Decimal?
  retentionAmount       Decimal?
  insuranceRequirements Json?
  status                ServiceContractStatus @default(DRAFT)
  signedAt              DateTime?
  
  // Approval & Versioning
  versionNumber         Int                   @default(1)
  approvalId            String?
  approval              Approval?             @relation(fields: [approvalId], references: [id])
  createdBy             String?

  // Relationships
  milestones        ServiceMilestone[]
  receipts          ServiceReceipt[]
  performances      ServicePerformance[]
  versions          ServiceContractVersion[]
  vendorResponses   VendorContractResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([approvalId])
  @@index([status])
  @@index([vendorId])
}

model ServiceMilestone {
  id                 String          @id @default(cuid())
  contractId         String
  contract           ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneNumber    Int
  name               String
  description        String?
  targetDate         DateTime
  completionCriteria String
  paymentPercentage  Decimal
  amount             Decimal
  status             MilestoneStatus @default(PENDING)
  completedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?

  // Relationships
  receipts ServiceReceipt[]
}

model ServiceReceipt {
  id                   String            @id @default(cuid())
  srnNumber            String            @unique
  contractId           String
  contract             ServiceContract   @relation(fields: [contractId], references: [id])
  milestoneId          String?
  milestone            ServiceMilestone? @relation(fields: [milestoneId], references: [id])
  receiptDate          DateTime          @default(now())
  serviceDescription   String
  deliverables         Json
  qualityRating        Decimal?
  performanceRating    Decimal?
  completionPercentage Decimal
  acceptanceStatus     AcceptanceStatus  @default(PENDING)
  acceptedBy           String?
  acceptedAt           DateTime?
  rejectionReason      String?
  notes                String?
  attachments          Json?
  createdBy            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePerformance {
  id               String          @id @default(cuid())
  contractId       String
  contract         ServiceContract @relation(fields: [contractId], references: [id])
  evaluationPeriod String
  startDate        DateTime
  endDate          DateTime
  qualityScore     Decimal
  timelinessScore  Decimal
  complianceScore  Decimal
  overallScore     Decimal
  kpiMetrics       Json?
  slaCompliance    Json?
  penalties        Decimal?        @default(0)
  bonuses          Decimal?        @default(0)
  evaluatedBy      String
  evaluatedAt      DateTime        @default(now())
  comments         String?
}

// Additional enums for services
enum ServiceContractStatus {
  DRAFT
  PENDING_APPROVAL // Submitted for approval, awaiting approvers
  APPROVED         // All approval levels completed
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONDITIONAL
}

// Automation and Workflow Models for 100% BRD Compliance

model WorkflowDefinition {
  id                String       @id @default(cuid())
  name              String
  description       String?
  workflowType      WorkflowType
  documentType      String // PR, PO, Invoice, etc.
  triggerConditions Json // Conditions that start this workflow
  approvalSteps     Json // Sequential approval steps
  notifications     Json // Email notification settings
  isActive          Boolean      @default(true)

  // Relationships
  instances WorkflowInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowInstance {
  id            String             @id @default(cuid())
  workflowDefId String
  workflowDef   WorkflowDefinition @relation(fields: [workflowDefId], references: [id])
  documentId    String // ID of PR, PO, Invoice being processed
  documentType  String // Type of document
  currentStep   Int                @default(1)
  totalSteps    Int
  status        WorkflowStatus     @default(IN_PROGRESS)
  assignedTo    String? // Current approver
  assignedAt    DateTime?
  completedAt   DateTime?

  // Relationships
  steps WorkflowStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStep {
  id           String           @id @default(cuid())
  instanceId   String
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNumber   Int
  stepName     String
  approverId   String
  approverRole String?
  status       StepStatus       @default(PENDING)
  comments     String?
  actionTaken  String? // APPROVED, REJECTED, ESCALATED
  processedAt  DateTime?
  dueDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationTrigger {
  id             String      @id @default(cuid())
  name           String
  triggerType    TriggerType
  conditions     Json // When to trigger (inventory level, budget, etc.)
  actions        Json // What to do (create PR, send notification, etc.)
  targetWorkflow String? // Workflow to start
  isActive       Boolean     @default(true)
  lastTriggered  DateTime?
  triggerCount   Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationQueue {
  id           String             @id @default(cuid())
  type         NotificationType
  recipient    String // Email address or user ID
  subject      String
  body         String
  templateData Json? // Data for email template
  status       NotificationStatus @default(PENDING)
  scheduledAt  DateTime           @default(now())
  sentAt       DateTime?
  errorMessage String?
  retryCount   Int                @default(0)
  maxRetries   Int                @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalMatrix {
  id            String   @id @default(cuid())
  documentType  String // PR, PO, Invoice
  department    String?
  amountMin     Decimal?
  amountMax     Decimal?
  approverRole  String
  approverLevel Int // 1st level, 2nd level, etc.
  isRequired    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessAudit {
  id           String   @id @default(cuid())
  processType  String // PR_CREATION, PO_APPROVAL, etc.
  documentId   String
  documentType String
  action       String // CREATED, APPROVED, REJECTED, etc.
  performedBy  String
  performedAt  DateTime @default(now())
  details      Json? // Additional audit details
  ipAddress    String?
  userAgent    String?
}

// Automation Enums
enum WorkflowType {
  APPROVAL
  NOTIFICATION
  VALIDATION
  GENERATION
}

enum WorkflowStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ESCALATED
  ERROR
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  ESCALATED
  SKIPPED
}

enum TriggerType {
  INVENTORY_LEVEL
  BUDGET_THRESHOLD
  TIME_BASED
  STATUS_CHANGE
  DOCUMENT_CREATION
}

enum NotificationType {
  EMAIL
  SMS
  SYSTEM
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model KPITarget {
  id        String   @id @default(cuid())
  kpiKey    String   @unique // e.g., 'procurementCycleTime', 'onTimeDeliveryRate'
  target    Decimal  // The target value for this KPI
  updatedBy String?  // User who last updated the target
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================
// CONTRACT VERSIONING AND VENDOR NEGOTIATION
// ============================================

// Contract Version History - Tracks all versions of a contract
model ServiceContractVersion {
  id                    String                @id @default(cuid())
  contractId            String
  contract              ServiceContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber         Int
  
  // Snapshot of contract data at this version
  contractNumber        String
  vendorId              String
  contractType          String
  startDate             DateTime
  endDate               DateTime
  totalValue            Decimal
  serviceAmount         Decimal?
  currency              String
  paymentTerms          String
  slaTerms              Json?
  penaltyClause         String?
  performanceBond       Decimal?
  retentionAmount       Decimal?
  insuranceRequirements Json?
  status                ServiceContractStatus
  
  // Version metadata
  changeReason          String? // Why was this version created?
  changeDescription     String? // What changed?
  createdBy             String
  createdByName         String? // Denormalized for easy display
  approvalStatus        String? // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  
  createdAt             DateTime              @default(now())
  
  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([createdAt])
}

// Vendor Contract Response - Tracks vendor acceptance/rejection of contracts
model VendorContractResponse {
  id                String                @id @default(cuid())
  contractId        String
  contract          ServiceContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber     Int
  
  // Response tracking
  responseToken     String                @unique // Secure token for email link
  vendorEmail       String
  vendorName        String?
  
  // Response details
  status            VendorResponseStatus  @default(PENDING)
  responseType      String? // ACCEPT, REJECT, REQUEST_CHANGES
  comments          String? // Vendor comments/feedback
  respondedAt       DateTime?
  respondedBy       String? // Name of person who responded
  
  // Email tracking
  emailSentAt       DateTime?
  emailOpenedAt     DateTime?
  reminderSentAt    DateTime?
  expiresAt         DateTime
  
  // Internal tracking
  processedBy       String? // Internal user who processed the response
  processedAt       DateTime?
  internalNotes     String?
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  
  @@index([contractId])
  @@index([responseToken])
  @@index([status])
  @@index([expiresAt])
}

// Vendor Response Status Enum
enum VendorResponseStatus {
  PENDING           // Waiting for vendor response
  ACCEPTED          // Vendor accepted the contract
  REJECTED          // Vendor rejected with comments
  EXPIRED           // Response token expired
  PROCESSED         // Response has been processed by internal team
}
