generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

// User Roles Enum
enum UserRole {
  SUPER_ADMIN // Super Administrator - full system access
  ADMIN // System Administrator - user & system management
  FINANCE_MANAGER // Approves payments, budget oversight
  PROCUREMENT_MANAGER // Approves POs, manages procurement
  BILLING_ENGINEER // Billing Engineer - contract financial approval
  PROJECT_MANAGER // Project-level approvals
  WAREHOUSE_KEEPER // Goods receipts, inventory
  PROCUREMENT_OFFICER // Creates POs, manages RFQs
  VIEWER // Read-only access
  // Legacy roles (for backward compatibility)
  REQUESTOR // Legacy - maps to VIEWER
  DEPARTMENT_MANAGER // Legacy - maps to APPROVER
  WAREHOUSE_MANAGER // Legacy - maps to WAREHOUSE_KEEPER
}

model Company {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  users User[]
}

model HrMaterialRequest {
  id                    String    @id @default(cuid())
  externalId            String    @unique
  budgetExternalId      String?
  departmentExternalId  String?
  categoryExternalId    String?
  status                String
  quantity              Int?
  description           String?
  notes                 String?
  rejectionReason       String?
  approvedByExternal    String?
  departmentName        String?
  categoryName          String?
  categoryPriceLimit    Decimal?
  budgetCategoryBudgets Json?
  requesterName         String?
  requesterFirstName    String?
  requesterLastName     String?
  requesterExternalId   String?
  requesterEmail        String?
  fiscalYear            Int?
  quarter               Int?
  externalVersion       Int?
  budgetTotalAmount     Decimal?
  externalCreatedAt     DateTime?
  externalUpdatedAt     DateTime?
  lastSyncedAt          DateTime  @default(now())
  rawPayload            Json
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  purchaseRequisitions PurchaseRequisition[]

  @@index([status])
  @@index([departmentName])
  @@index([externalUpdatedAt])
}

model HrDepartment {
  id                String    @id @default(cuid())
  externalId        String?   @unique
  name              String
  type              String?
  isActive          Boolean   @default(true)
  code              String?
  costCenterCode    String?
  parentExternalId  String?
  description       String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime  @default(now())
  rawPayload        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequisitions PurchaseRequisition[] @relation("PRDepartment")
  servicePRs          ServicePR[]            @relation("ServicePRDepartment")
  serviceContracts    ServiceContract[]

  @@index([name])
  @@index([code])
  @@index([type])
  @@index([isActive])
  @@index([externalUpdatedAt])
}

model Project {
  id                String    @id @default(cuid())
  externalId        String?   @unique
  companyId         String?
  projectCode       String?   @map("code")
  projectName       String    @map("name")
  description       String?
  status            String?
  startDate         DateTime?
  endDate           DateTime?
  projectManager    String?
  department        String?   @map("departmentName")
  isActive          Boolean   @default(true)
  totalBudget       Decimal?  @default(0)
  allocatedBudget   Decimal?  @default(0)
  actualSpent       Decimal?  @default(0)
  externalSystemId  String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime  @default(now())
  rawPayload        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequisitions PurchaseRequisition[] @relation("PRProject")
  servicePRs          ServicePR[]            @relation("ServicePRProject")
  serviceContracts    ServiceContract[]

  @@index([projectCode])
  @@index([projectName])
  @@index([companyId])
  @@index([status])
  @@index([isActive])
  @@index([department])
  @@index([externalUpdatedAt])
  @@map("HrProject")
}

// User Model
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String // Hashed password
  name                String
  employeeId          String?   @unique
  mobile              String?
  department          String?
  role                UserRole  @default(VIEWER)
  approvalLimit       Decimal?  @default(0) // Max amount user can approve
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIP         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  companyId           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?

  // Relations
  company         Company           @relation(fields: [companyId], references: [id])
  sessions        Session[]
  passwordHistory PasswordHistory[]
  // createdPRs           PurchaseRequisition[] @relation("PRCreator")  // Temporarily disabled
  // approvals            Approval[]  // Temporarily disabled

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([companyId])
}

// Session Model (for JWT session management)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Password History (prevent password reuse)
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Audit Log (track all user actions)

// ============================================
// VENDOR MANAGEMENT
// ============================================

// Vendor Management
model Vendor {
  id         String  @id @default(cuid())
  vendorCode String  @unique
  nameEn     String
  nameAr     String
  crNumber   String  @unique
  taxId      String  @unique
  vatNumber  String?

  // Contact Information
  primaryContactName String
  email              String
  mobile             String
  alternativePhone   String?
  website            String?
  address            Json

  // Banking Information
  bankName    String?
  bankAccount String?
  iban        String?

  // Business Details
  businessType      String
  yearEstablished   Int
  numberOfEmployees Int

  // Status
  status           VendorStatus @default(PENDING)
  performanceScore Float?

  // Relationships
  categories          VendorCategory[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  documents           VendorDocument[]
  evaluations         VendorEvaluation[]
  rfqResponses        RFQResponse[]
  rfqInvitations      RFQVendor[] // Vendors invited to RFQs
  serviceRFPVendors   ServiceRFPVendor[]
  serviceRFPResponses ServiceRFPResponse[]
  serviceContracts    ServiceContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorCategory {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isPrimary  Boolean  @default(false)

  @@unique([vendorId, categoryId])
}

model VendorDocument {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  documentType String
  documentName String
  fileUrl      String
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())
}

model VendorEvaluation {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  evaluationDate DateTime @default(now())
  qualityScore   Float
  deliveryScore  Float
  priceScore     Float
  serviceScore   Float
  overallScore   Float
  comments       String?
  evaluatedBy    String
}

model Category {
  id          String           @id @default(cuid())
  code        String           @unique
  nameEn      String
  nameAr      String
  description String?
  parent      Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    Category[]       @relation("CategoryHierarchy")
  vendors     VendorCategory[]
  items       Item[]
}

model UnitOfMeasure {
  id               String   @id @default(cuid())
  externalId       String?  @unique
  code             String   @unique
  name             String
  abbreviation     String
  type             UOMType
  isActive         Boolean  @default(true)
  externalUpdatedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([externalUpdatedAt])
}

model Item {
  id                  String    @id @default(cuid())
  externalId          String?   @unique
  itemCode            String    @unique
  nameEn              String
  nameAr              String
  description         String?
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id])
  unitOfMeasure       String
  minStockLevel       Int?
  maxStockLevel       Int?
  reorderPoint        Int?
  reorderQuantity     Int?
  leadTimeDays        Int?
  shelfLifeDays       Int?
  itemStatus          String?
  stockType           String?
  isCritical          Boolean   @default(false)
  isHazardous         Boolean   @default(false)
  storageCondition    String?
  hsnCode             String?
  barcode             String?
  categoryExternalId  String?
  categoryName        String?
  itemGroupExternalId String?
  itemGroupName       String?
  baseUomExternalId   String?
  baseUomName         String?
  baseUomAbbreviation String?
  integrationSource   String?
  externalUpdatedAt   DateTime?
  lastSyncedAt        DateTime?
  rawPayload          Json?

  // Relationships
  prItems      PRItem[]
  poItems      POItem[]
  grItems      GRItem[]
  invoiceItems InvoiceItem[]
  servicePRMaterialItems ServicePRMaterialItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalUpdatedAt])
}

// Purchase Requisition
model PurchaseRequisition {
  id                String   @id @default(cuid())
  prNumber          String   @unique
  requestDate       DateTime @default(now())
  requesterId       String?
  // requester       User?    @relation("PRCreator", fields: [requesterId], references: [id])  // Temporarily disabled
  departmentId      String?
  itemType          ItemType
  priority          Priority @default(NORMAL)
  status            PRStatus @default(DRAFT)
  // Integration/source metadata
  integrationSource String?
  externalId        String?  @unique
  externalStatus    String?
  externalPriority  String?

  // Inventory material requisition compatibility fields
  mrNumber                String?
  requestedById           String?
  requestBasis            String?
  requestedDepartmentId   String?
  requestedDepartmentName String?
  requestedProjectId      String?
  requestedProjectName    String?
  wbsCodeId               String?
  deliveryWarehouseId     String?
  committedCost           Decimal?
  submittedAt             DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  fulfilledAt             DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  procurementPrId         String?
  projectExternalId       String?
  projectCode             String?
  projectName             String?
  departmentExternalId    String?
  departmentName          String?
  requesterExternalId     String?
  requesterName           String?
  requesterEmail          String?
  requiredDate            DateTime?
  purpose                 String?
  externalCreatedAt       DateTime?
  externalUpdatedAt       DateTime?
  lastSyncedAt            DateTime?
  rawPayload              Json?

  // Commercial
  estimatedCost Decimal
  justification String?

  // Additional fields
  requiredByDate          DateTime?
  projectId               String?
  sourceMaterialRequestId String?
  sourceMaterialRequest   HrMaterialRequest? @relation(fields: [sourceMaterialRequestId], references: [id], onDelete: SetNull)
  department              HrDepartment?      @relation("PRDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  project                 Project?           @relation("PRProject", fields: [projectId], references: [id], onDelete: SetNull)
  createdBy               String?

  // Items
  items PRItem[]

  // Approval
  approvals Approval[]

  // Relationships
  purchaseOrders               PurchaseOrder[]               @relation("POFromPR")
  sourceMaterialPurchaseOrders PurchaseOrder[]               @relation("POSourceMaterialRequisition")
  rfqs                         RFQ[]
  documents                    PurchaseRequisitionDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([departmentId])
  @@index([projectId])
  @@index([sourceMaterialRequestId])
  @@index([externalUpdatedAt])
  @@index([mrNumber])
  @@index([projectName])
  @@index([requestedProjectName])
}

model PurchaseRequisitionDocument {
  id           String              @id @default(cuid())
  prId         String
  pr           PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime            @default(now())

  @@index([prId])
  @@index([uploadedAt])
}

model PRItem {
  id             String              @id @default(cuid())
  prId           String
  pr             PurchaseRequisition @relation(fields: [prId], references: [id])
  itemId         String
  item           Item                @relation(fields: [itemId], references: [id])
  quantity       Int
  estimatedPrice Decimal
  specifications String?
  requiredDate   DateTime?
}

// RFQ Management
model RFQ {
  id          String               @id @default(cuid())
  rfqNumber   String               @unique
  prId        String?
  pr          PurchaseRequisition? @relation(fields: [prId], references: [id])
  title       String
  description String?
  issueDate   DateTime             @default(now())
  closingDate DateTime
  status      RFQStatus            @default(DRAFT)
  createdBy   String? // User who created the RFQ

  // Additional fields for enhanced RFQ management
  evaluationCriteria String? // JSON string for evaluation criteria
  termsAndConditions String? // Terms and conditions text

  // Responses
  responses RFQResponse[]
  documents RFQDocument[]

  // Approval
  approvals Approval[]

  // Invited Vendors
  invitedVendors RFQVendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Junction table for RFQ and Vendors (invited vendors)
model RFQVendor {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  invitedAt DateTime @default(now())

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
}

model RFQResponse {
  id              String            @id @default(cuid())
  rfqId           String
  rfq             RFQ               @relation(fields: [rfqId], references: [id])
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  submittedAt     DateTime          @default(now())
  totalAmount     Decimal?
  validUntil      DateTime?
  status          RFQResponseStatus @default(SUBMITTED)
  technicalScore  Float?
  commercialScore Float?
  deliveryScore   Float?
  experienceScore Float?
  overallScore    Float? // Weighted total score

  // File attachments
  proposalFileUrl String? // Path to uploaded PDF
  attachments     Json? // Array of additional file paths

  // Additional proposal data
  priceBreakdown     String? // Price breakdown details
  technicalDetails   String? // Technical specifications
  deliveryTerms      String? // Delivery terms and conditions
  notes              String? // Additional notes
  awardJustification String? // Justification entered when selecting this response as winner

  // Submission tracking
  submittedVia    String?   @default("EMAIL_LINK") // 'PORTAL', 'EMAIL_LINK', 'MANUAL'
  submissionToken String?   @unique // Unique token for email link submission
  submissionIp    String? // IP address of submission
  tokenSentAt     DateTime? // When the email with token was sent
  tokenUsed       Boolean   @default(false) // Whether token has been used
  token           String? // Alternative token field

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([rfqId, vendorId])
  @@index([submissionToken])
}

model RFQDocument {
  id           String   @id @default(cuid())
  rfqId        String
  rfq          RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime @default(now())

  @@index([rfqId])
  @@index([uploadedAt])
}

// Service RFP Models
model ServiceRFP {
  id                 String    @id @default(cuid())
  rfpNumber          String    @unique
  servicePrId        String    @unique
  title              String
  description        String?   @db.Text
  issueDate          DateTime  @default(now())
  closingDate        DateTime
  status             RFPStatus @default(DRAFT)
  createdBy          String
  evaluationCriteria String?   @db.Text
  termsAndConditions String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  servicePR      ServicePR            @relation(fields: [servicePrId], references: [id])
  invitedVendors ServiceRFPVendor[]
  responses      ServiceRFPResponse[]
  documents      ServiceRFPDocument[]
  approvals      Approval[]           @relation("ServiceRFPApprovals")
}

model ServiceRFPDocument {
  id           String     @id @default(cuid())
  rfpId        String
  rfp          ServiceRFP @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime   @default(now())

  @@index([rfpId])
  @@index([uploadedAt])
}

model ServiceRFPVendor {
  id        String   @id @default(cuid())
  rfpId     String
  vendorId  String
  invitedAt DateTime @default(now())

  rfp    ServiceRFP @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendor Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([rfpId, vendorId])
}

model ServiceRFPResponse {
  id          String            @id @default(cuid())
  rfpId       String
  vendorId    String
  submittedAt DateTime?
  totalAmount Decimal?          @db.Decimal(15, 3)
  validUntil  DateTime?
  status      RFQResponseStatus @default(SUBMITTED)

  // Scoring
  technicalScore  Int?
  commercialScore Int?
  deliveryScore   Int?
  experienceScore Int?
  overallScore    Decimal? @db.Decimal(5, 2)

  // Submission details
  proposalFileUrl  String?
  attachments      String? @db.Text
  priceBreakdown   String? @db.Text
  technicalDetails String? @db.Text
  deliveryTerms    String? @db.Text
  notes            String? @db.Text
  awardJustification String? @db.Text

  // Token and tracking
  submittedVia    String?
  submissionToken String?   @unique
  submissionIp    String?
  tokenSentAt     DateTime?
  tokenUsed       Boolean   @default(false)
  token           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfp    ServiceRFP @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendor Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([rfpId, vendorId])
}

// Purchase Order
model PurchaseOrder {
  id                          String               @id @default(cuid())
  poNumber                    String               @unique
  prId                        String?
  pr                          PurchaseRequisition? @relation("POFromPR", fields: [prId], references: [id])
  sourceMaterialRequisitionId String?
  sourceMaterialRequisition   PurchaseRequisition? @relation("POSourceMaterialRequisition", fields: [sourceMaterialRequisitionId], references: [id], onDelete: SetNull)
  sourceServiceContractId     String?
  sourceDepartmentId          String?
  sourceDepartmentName        String?
  sourceProjectId             String?
  sourceProjectName           String?
  vendorId                    String
  vendor                      Vendor               @relation(fields: [vendorId], references: [id])
  orderDate                   DateTime             @default(now())
  deliveryDate                DateTime
  deliveryAddress             Json
  paymentTerms                String
  status                      POStatus             @default(DRAFT)
  totalAmount                 Decimal
  invoicedAmount              Decimal              @default(0)
  currency                    String               @default("OMR")
  createdBy                   String? // User who created the PO
  acknowledgmentToken         String?              @unique // Token for vendor acknowledgment via email
  acknowledgedAt              DateTime? // When vendor acknowledged the PO
  acknowledgedBy              String? // Vendor email or identifier

  // Items
  items POItem[]

  // Approval
  approvals Approval[]

  // Related documents
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  amendments    POAmendment[]
  documents     PurchaseOrderDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceMaterialRequisitionId])
}

model PurchaseOrderDocument {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime      @default(now())

  @@index([poId])
  @@index([uploadedAt])
}

model POItem {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  quantity     Int
  unitPrice    Decimal
  totalPrice   Decimal
  deliveryDate DateTime?

  // Relations
  invoiceItems InvoiceItem[]
}

model POAmendment {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  amendmentNo  Int
  changeType   String
  description  String
  oldValue     Json
  newValue     Json
  approvedBy   String?
  approvedDate DateTime?
  createdAt    DateTime      @default(now())
}

// Goods Receipt
model GoodsReceipt {
  id                String              @id @default(cuid())
  grNumber          String              @unique
  // Inventory model compatibility
  externalId        String?             @unique
  externalUpdatedAt DateTime?
  externalCreatedAt DateTime?
  lastSyncedAt      DateTime?
  rawPayload        Json?
  grnNumber         String?             @unique
  purchaseOrderId   String?
  supplierId        String?
  warehouseId       String?
  receiptDate       DateTime?
  receiptReason     GoodsReceiptReason?
  vehicleNumber     String?
  driverName        String?
  receivedById      String?
  inspectedBy       String?
  inspectedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  remarks           String?
  poId              String?
  po                PurchaseOrder?      @relation(fields: [poId], references: [id])
  receivedDate      DateTime            @default(now())
  receivedBy        String
  status            GRStatus            @default(PENDING)

  // Receipt Details
  deliveryNote     String?
  transportDetails String?
  storageLocation  String?
  specialHandling  String?

  // Items
  items GRItem[]

  // Quality Check
  qualityChecked   Boolean @default(false)
  qualityComments  String?
  qualityInspector String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalUpdatedAt])
  @@index([status])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([warehouseId])
}

model GRItem {
  id                String        @id @default(cuid())
  grId              String
  gr                GoodsReceipt  @relation(fields: [grId], references: [id])
  itemId            String
  item              Item          @relation(fields: [itemId], references: [id])
  orderedQuantity   Float
  deliveredQuantity Float         @default(0)
  receivedQuantity  Float         @default(0)
  acceptedQuantity  Float
  rejectedQuantity  Float         @default(0)
  unitPrice         Float?
  currency          String        @default("OMR")
  rejectionReason   String?
  batchNumber       String?
  serialNumber      String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  storageLocation   String?
  qualityStatus     QualityStatus @default(PENDING)
  remarks           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([grId])
  @@index([itemId])
}

// Invoice Management
model Invoice {
  id             String         @id @default(cuid())
  invoiceNumber  String         @unique
  vendorId       String
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id])
  invoiceDate    DateTime
  dueDate        DateTime
  totalAmount    Decimal
  taxAmount      Decimal
  discountAmount Decimal        @default(0)
  netAmount      Decimal        @default(0)
  currency       String         @default("OMR")

  // Status
  status InvoiceStatus @default(DRAFT)

  // Three-way matching
  threeWayMatched  Boolean        @default(false)
  matchingComments String?
  matchingStatus   MatchingStatus @default(PENDING)

  // Payment
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentDate      DateTime?
  paymentReference String?
  amountPaid       Decimal       @default(0)

  // Additional fields
  description  String?
  paymentTerms String?
  attachments  String[]

  // Line items
  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  poItemId    String?
  poItem      POItem? @relation(fields: [poItemId], references: [id])
  itemId      String
  item        Item    @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Approval Workflow
model Approval {
  id           String @id @default(cuid())
  documentType String
  documentId   String

  // Document relationships
  purchaseRequisitionId String?
  purchaseOrderId       String?
  invoiceId             String?
  rfqId                 String?
  prId                  String?
  serviceRFPId          String?
  serviceContractId     String?
  servicePrId           String?
  pr                    PurchaseRequisition? @relation(fields: [prId], references: [id])
  po                    PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  rfq                   RFQ?                 @relation(fields: [rfqId], references: [id])
  serviceRFP            ServiceRFP?          @relation("ServiceRFPApprovals", fields: [serviceRFPId], references: [id])
  servicePR             ServicePR?           @relation(fields: [servicePrId], references: [id])
  serviceContracts      ServiceContract[]

  // Approval details
  approverId String
  // approver            User     @relation(fields: [approverId], references: [id])  // Temporarily disabled
  status     ApprovalStatus @default(PENDING)
  comments   String?
  approvedAt DateTime?
  level      Int

  // History
  approvalHistory ApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([approverId])
  @@index([prId])
  @@index([purchaseRequisitionId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
  @@index([rfqId])
  @@index([serviceContractId])
  @@index([servicePrId])
  @@index([status])
}

// Enhanced Approval History
model ApprovalHistory {
  id             String          @id @default(cuid())
  approvalId     String
  approval       Approval        @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  serviceContractId     String?
  serviceContract       ServiceContract? @relation(fields: [serviceContractId], references: [id], onDelete: Cascade)
  contractVersionNumber Int?
  level          Int // Approval level this action occurred at
  action         String // SUBMITTED, APPROVED, REJECTED, DELEGATED, ESCALATED, REQUEST_EDIT
  performedBy    String?
  approverId     String? // User ID who performed the action
  approverName   String? // User name for display
  previousStatus ApprovalStatus?
  newStatus      ApprovalStatus?
  comments       String?
  metadata       Json? // Additional context
  timestamp      DateTime? // When the action occurred

  createdAt DateTime @default(now())

  @@index([approvalId])
  @@index([serviceContractId])
  @@index([contractVersionNumber])
  @@index([performedBy])
  @@index([approverId])
  @@index([level])
}

