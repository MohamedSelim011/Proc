// Service-specific models for proper non-stock/service procurement

model ServiceCategory {
  id                      String  @id @default(cuid())
  code                    String  @unique
  nameEn                  String
  nameAr                  String
  description             String?
  requiresInsurance       Boolean @default(false)
  requiresCertification   Boolean @default(false)
  requiresPerformanceBond Boolean @default(false)

  // Relationships
  serviceItems ServiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceItem {
  id                 String          @id @default(cuid())
  serviceCode        String          @unique
  nameEn             String
  nameAr             String
  description        String?
  serviceCategoryId  String
  serviceCategory    ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  unitOfMeasure      String
  standardRate       Decimal?
  currency           String          @default("OMR")
  slaRequired        Boolean         @default(false)
  performanceMetrics Json?

  // Relationships
  servicePRItems ServicePRItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePR {
  id                      String     @id @default(cuid())
  prNumber                String     @unique
  requestDate             DateTime   @default(now())
  requesterId             String?
  departmentId            String?
  projectId               String?
  requestBasis            String?
  priority                Priority   @default(NORMAL)
  status                  PRStatus   @default(DRAFT)
  estimatedCost           Decimal    @default(0)
  justification           String?
  requiredByDate          DateTime?
  createdBy               String?

  department              HrDepartment? @relation("ServicePRDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  project                 Project?      @relation("ServicePRProject", fields: [projectId], references: [id], onDelete: SetNull)

  serviceScope            String
  serviceCategory         String?
  serviceType             String?
  requestor               String?
  technicalSpecifications String?
  qualityStandards        String?
  duration                Int
  durationUnit            String     @default("DAYS")
  deliverables            Json
  performanceMetrics      Json?
  slaRequirements         Json?
  certificationRequired   Boolean    @default(false)
  safetyRequirements      String?
  paymentSchedule         String     @default("MILESTONE")
  paymentTerms            String?
  preferredVendors        Json?
  milestones              Json?

  items            ServicePRItem[]
  materialItems    ServicePRMaterialItem[]
  documents        ServicePRDocument[]
  approvals        Approval[]
  serviceRFP       ServiceRFP?
  serviceContracts ServiceContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([departmentId])
  @@index([projectId])
}

model ServicePRItem {
  id                 String      @id @default(cuid())
  servicePRId        String
  servicePR          ServicePR   @relation(fields: [servicePRId], references: [id], onDelete: Cascade)
  serviceItemId      String
  serviceItem        ServiceItem @relation(fields: [serviceItemId], references: [id])
  quantity           Decimal
  estimatedRate      Decimal
  unit               String?     @default("Hours") // Unit of measure
  duration           Int
  durationUnit       String      @default("DAYS")
  specifications     String?
  deliverables       Json?
  performanceMetrics Json?
}

model ServicePRMaterialItem {
  id             String     @id @default(cuid())
  servicePrId    String
  servicePR      ServicePR  @relation(fields: [servicePrId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item       @relation(fields: [itemId], references: [id])
  quantity       Decimal
  estimatedPrice Decimal
  specifications String?
  requiredDate   DateTime?
}

model ServicePRDocument {
  id           String     @id @default(cuid())
  servicePrId  String
  servicePR    ServicePR  @relation(fields: [servicePrId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime   @default(now())

  @@index([servicePrId])
  @@index([uploadedAt])
}

model ServiceContract {
  id                    String                @id @default(cuid())
  contractNumber        String                @unique
  servicePrId           String
  servicePR             ServicePR             @relation(fields: [servicePrId], references: [id])
  vendorId              String
  vendor                Vendor                @relation(fields: [vendorId], references: [id])
  contractType          String                @default("SERVICE_AGREEMENT")
  startDate             DateTime
  endDate               DateTime
  totalValue            Decimal
  serviceAmount         Decimal? // Service-only portion; for service-only contracts equals totalValue
  currency              String                @default("OMR")
  paymentTerms          String
  slaTerms              Json?
  penaltyClause         String?
  performanceBond       Decimal?
  retentionAmount       Decimal?
  insuranceRequirements Json?
  status                ServiceContractStatus @default(DRAFT)
  signedAt              DateTime?

  // Approval & Versioning
  versionNumber Int       @default(1)
  approvalId    String?
  approval      Approval? @relation(fields: [approvalId], references: [id])
  createdBy     String?
  departmentId  String?
  projectId     String?

  department    HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relationships
  milestones      ServiceMilestone[]
  receipts        ServiceReceipt[]
  performances    ServicePerformance[]
  versions        ServiceContractVersion[]
  vendorResponses VendorContractResponse[]
  documents       ServiceContractDocument[]
  approvalHistory ApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalId])
  @@index([status])
  @@index([vendorId])
  @@index([departmentId])
  @@index([projectId])
}

model ServiceContractDocument {
  id           String          @id @default(cuid())
  contractId   String
  contract     ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentType String?
  documentName String
  fileUrl      String
  storageKey   String
  fileSize     Int
  fileType     String
  uploadedBy   String?
  uploadedAt   DateTime        @default(now())

  @@index([contractId])
  @@index([uploadedAt])
}

model ServiceMilestone {
  id                 String          @id @default(cuid())
  contractId         String
  contract           ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneNumber    Int
  name               String
  description        String?
  targetDate         DateTime
  completionCriteria String
  paymentPercentage  Decimal
  amount             Decimal
  completedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?

  // Relationships
  receipts ServiceReceipt[]
}

model ServiceReceipt {
  id                   String            @id @default(cuid())
  srnNumber            String            @unique
  contractId           String
  contract             ServiceContract   @relation(fields: [contractId], references: [id])
  milestoneId          String?
  milestone            ServiceMilestone? @relation(fields: [milestoneId], references: [id])
  receiptDate          DateTime          @default(now())
  serviceDescription   String
  deliverables         Json
  qualityRating        Decimal?
  performanceRating    Decimal?
  completionPercentage Decimal
  acceptanceStatus     AcceptanceStatus  @default(PENDING)
  acceptedBy           String?
  acceptedAt           DateTime?
  rejectionReason      String?
  notes                String?
  attachments          Json?
  createdBy            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePerformance {
  id               String                       @id @default(cuid())
  contractId       String
  contract         ServiceContract              @relation(fields: [contractId], references: [id])
  evaluationPeriod String
  startDate        DateTime
  endDate          DateTime
  qualityScore     Decimal
  timelinessScore  Decimal
  complianceScore  Decimal
  overallScore     Decimal
  kpiMetrics       Json?
  slaCompliance    Json?
  penalties        Decimal?                     @default(0)
  bonuses          Decimal?                     @default(0)
  evaluatedBy      String
  evaluatedAt      DateTime                     @default(now())
  comments         String?
  documents        ServicePerformanceDocument[]
}

model ServicePerformanceDocument {
  id            String             @id @default(cuid())
  performanceId String
  performance   ServicePerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  documentType  String?
  documentName  String
  fileUrl       String
  storageKey    String
  fileSize      Int
  fileType      String
  uploadedBy    String?
  uploadedAt    DateTime           @default(now())

  @@index([performanceId])
  @@index([uploadedAt])
}

model ActivityLog {
  id            String   @id @default(cuid())
  type          String
  entityType    String
  entityId      String?
  title         String
  status        String?
  amount        Decimal?
  currency      String?
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([entityType])
  @@index([createdAt])
}

