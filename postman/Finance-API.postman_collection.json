{
  "info": {
    "name": "Procurement - Finance API",
    "description": "APIs for the finance system to read purchase orders, vendors, and service contracts. Use either Bearer token (for SSO) or API key (X-API-Key or Authorization: ApiKey). Send X-Request-Id to correlate logs when debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "api_key", "value": "" },
    { "key": "request_id", "value": "" },
    { "key": "poId", "value": "" },
    { "key": "vendorId", "value": "" },
    { "key": "contractId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth: Bearer Token",
      "item": [
        {
          "name": "List POs (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/purchase-orders?page=1&limit=10"
          }
        },
        {
          "name": "Get one PO by ID or PO Number (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/purchase-orders/{{poId}}"
          }
        },
        {
          "name": "Update PO Status (Token)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACKNOWLEDGED\",\n  \"comments\": \"Status updated by finance workflow\",\n  \"updatedBy\": \"finance.api\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/purchase-orders/{{poId}}/status"
          }
        },
        {
          "name": "List Vendors (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/vendors?page=1&limit=10"
          }
        },
        {
          "name": "Get one Vendor with POs (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/vendors/{{vendorId}}"
          }
        },
        {
          "name": "List Contracts (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/contracts?page=1&limit=10"
          }
        },
        {
          "name": "Get one Contract (Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/contracts/{{contractId}}"
          }
        }
      ]
    },
    {
      "name": "Auth: API Key",
      "item": [
        {
          "name": "List POs (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/purchase-orders?page=1&limit=10"
          }
        },
        {
          "name": "Get one PO by ID or PO Number (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/purchase-orders/{{poId}}"
          }
        },
        {
          "name": "Update PO Status (API Key)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACKNOWLEDGED\",\n  \"comments\": \"Status updated by finance workflow\",\n  \"updatedBy\": \"finance.api\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/purchase-orders/{{poId}}/status"
          }
        },
        {
          "name": "List Vendors (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/vendors?page=1&limit=10"
          }
        },
        {
          "name": "Get one Vendor with POs (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/vendors/{{vendorId}}"
          }
        },
        {
          "name": "List Contracts (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/contracts?page=1&limit=10"
          }
        },
        {
          "name": "Get one Contract (API Key)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "X-Request-Id", "value": "{{request_id}}", "disabled": true }
            ],
            "url": "{{base_url}}/api/finance/contracts/{{contractId}}"
          }
        }
      ]
    }
  ]
}
