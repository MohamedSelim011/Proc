# Database
DATABASE_URL="postgresql://username:password@localhost:5432/procurement_db"

# Metabase Configuration
METABASE_URL=https://metabase-production-9c0c.up.railway.app
METABASE_SECRET_KEY=your_metabase_secret_key_here
METABASE_DASHBOARD_ID=1

# Public Metabase Configuration (accessible on client-side)
NEXT_PUBLIC_METABASE_DASHBOARD_ID=1

# App URL used to generate links in emails (vendor portals, PO acknowledge, contract response pages)
APP_BASE_URL=http://localhost:3000
# Backward-compatible fallback key used by existing deployments
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Finance API (for external finance system integration)
# Optional: when set, finance endpoints accept X-API-Key or Authorization: ApiKey <key>
FINANCE_API_KEY=

# Inventory API (for external inventory system integration)
# Optional: when set, inventory endpoints accept X-API-Key or Authorization: ApiKey <key>
INVENTORY_API_KEY=

# Inventory system (Wujha Inventory) – used when loading items and creating MR for material requisitions only
# Base URL of the Inventory app; Procurement calls it for: items catalog, check-availability, create MR
INVENTORY_SYSTEM_BASE_URL=
# API key for server-to-server calls from Procurement to Inventory (Inventory team provides it)
INVENTORY_SYSTEM_API_KEY=

# Company branding
NEXT_PUBLIC_COMPANY_NAME="WUJHA"
NEXT_PUBLIC_LOGO="/wujha.jpg"
NEXT_PUBLIC_FAVICON="/favicon/favicon.ico"

# Theme colors (hex OR rgb triplet)
THEME_PRIMARY_COLOR="#FF5722"
THEME_PRIMARY_HOVER_COLOR="#E64A19"
THEME_SECONDARY_COLOR="#fa6335"
THEME_SECONDARY_HOVER_COLOR="#e85a2f"

# S3 Storage (Railway)
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
